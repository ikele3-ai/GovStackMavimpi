# Copiez ce fichier en .env puis adaptez les valeurs.

# Nom de domaine pointant vers le VPS (enregistrement DNS A) – ex. dossier.sante.gouv.cd
DOMAIN=dossier.exemple.cd
# E-mail pour les certificats Let's Encrypt
ACME_EMAIL=admin@exemple.cd

# Compte administrateur créé au premier démarrage.
# Laissez ADMIN_PASSWORD vide pour qu'un mot de passe temporaire soit affiché dans les logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Durée d'une session (heures)
SESSION_TTL_HOURS=12
# Préfixe du Numéro Unique Patient
NUP_PREFIX=CD
APP_NAME=GovStack Santé RDC
# Nombre de sauvegardes conservées
BACKUP_KEEP=30
